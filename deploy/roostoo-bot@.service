[Unit]
Description=Roostoo competition bot (%i)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/roostoo-hackathon
EnvironmentFile=/home/ubuntu/roostoo-hackathon/.env
ExecStart=/usr/bin/python3 -m bot.run config/%i.yaml
Restart=always
RestartSec=10
StandardOutput=append:/home/ubuntu/roostoo-hackathon/live/%i.out
StandardError=append:/home/ubuntu/roostoo-hackathon/live/%i.out

[Install]
WantedBy=multi-user.target
